# LLM provider for the conformance audit.
# DeepSeek is the default; any OpenAI-compatible endpoint works. Alternatively set
# OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL, or the generic LLM_* equivalents.
DEEPSEEK_API_KEY="sk-your-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

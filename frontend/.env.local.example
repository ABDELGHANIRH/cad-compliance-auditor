# Copy to .env.local and fill in. .env.local is gitignored; this file is not.

# Origin of the FastAPI backend. Used only by the Next.js dev-server rewrite
# that proxies /static/* so generated GLB files are fetched same-origin.
# Override this when the backend runs somewhere other than the local default.
BACKEND_ORIGIN=http://127.0.0.1:8000

# DeepSeek key for the CAD Copilot tab (src/app/api/copilot/route.ts).
# Server-side only - never expose this to the browser. Get one from
# https://platform.deepseek.com/api_keys.
DEEPSEEK_API_KEY=
